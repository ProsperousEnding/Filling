{
  "name": "vue-blog-framework",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "description": "一个基于 Vue 3 的静态博客框架",
  "author": "ProsperousEnding",
  "license": "MIT",
  "keywords": [
    "vue",
    "blog",
    "framework",
    "component",
    "vue3",
    "pinia",
    "tailwind"
  ],
  "files": [
    "dist-lib"
  ],
  "main": "dist-lib/vue-blog-framework.umd.cjs",
  "module": "dist-lib/vue-blog-framework.es.js",
  "exports": {
    ".": {
      "import": "./dist-lib/vue-blog-framework.es.js",
      "require": "./dist-lib/vue-blog-framework.umd.cjs"
    },
    "./style.css": "./dist-lib/style.css"
  },
  "scripts": {
    "build:config": "node scripts/build-site-config.mjs",
    "build:content-index": "node scripts/build-content-index.mjs",
    "dev": "vite",
    "build": "vite build && node scripts/generate-static.mjs",
    "build:lib": "vite build --config vite.config.lib.js",
    "test": "pnpm test:unit && pnpm test:components",
    "test:unit": "node --test tests/*.test.js",
    "test:components": "vitest run --config vitest.config.js",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "playwright test tests/e2e/visual.spec.js --project=chromium --grep @visual",
    "test:bundle": "node scripts/verify-bundle-size.mjs",
    "test:site": "node scripts/verify-site-build.mjs",
    "test:package": "node scripts/verify-library-package.mjs",
    "audit:prod": "pnpm audit --prod",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:check": "wrangler deploy --config worker/wrangler.jsonc --dry-run --outdir dist-worker",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm audit:prod && pnpm test && pnpm test:e2e && pnpm build && pnpm test:site && pnpm test:bundle && pnpm build:lib && pnpm test:package && pnpm worker:check",
    "prepack": "pnpm test && pnpm build:lib && pnpm test:package"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@lucide/vue": "^1.33.0",
    "front-matter": "^4.0.2",
    "smol-toml": "^1.8.0"
  },
  "peerDependencies": {
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.10",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/compiler-sfc": "^3.5.30",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.11.2",
    "markdown-it": "^14.1.0",
    "pinia": "^2.1.7",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.1",
    "vite": "7.1.5",
    "vitest": "^4.1.11",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "wrangler": "^4.124.0"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@3": "3.15.1",
      "nanoid@3": "3.3.18"
    }
  }
}
